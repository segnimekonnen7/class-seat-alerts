# Copy to .env and fill in. Never commit the real .env.
APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/seatalerts
REDIS_URL=redis://localhost:6379/0

# Where the course schedule lives. {term} is substituted per request.
SCHEDULE_BASE_URL=https://example.edu/course-schedule
SCHEDULE_USER_AGENT=class-seat-alerts/1.0 (student project; contact segnimekonnen7@gmail.com)

# Politeness. The scraper never exceeds this many requests to the school in
# any rolling window, no matter how many sections are being watched.
SCRAPE_REQUESTS_PER_WINDOW=30
SCRAPE_WINDOW_SECONDS=60

# How often a section is re-checked. Closed sections are checked on the short
# interval -- those are the ones that might open.
POLL_INTERVAL_CLOSED_SECONDS=60
POLL_INTERVAL_OPEN_SECONDS=600

# Telegram. Leave the token blank to disable the channel.
TELEGRAM_BOT_TOKEN=

# SMTP. Leave the host blank to disable the channel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@example.edu
SMTP_USE_TLS=true

# If set, write endpoints require this in an X-API-Key header.
API_KEY=

# One person may not watch more sections than this.
MAX_WATCHES_PER_DESTINATION=25
